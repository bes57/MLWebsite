filter(last_chord_from == current_last) %>%
arrange(desc(prob)) %>%
slice_head(n = top_n)
for (i in seq_len(nrow(transitions))) {
child_bar <- transitions$bar_to[i]
edge <- tibble(from = current_bar, to = child_bar, prob = transitions$prob[i])
tree_edges <<- bind_rows(tree_edges, edge)
if (!(child_bar %in% visited)) {
visited <<- c(visited, child_bar)
expand_node(child_bar, depth + 1)
}
}
}
visited <- c(start_bar)
expand_node(start_bar, 1)
return(list(edges = tree_edges, start_bar = start_bar))
}
# Build the tree
tree_result <- build_probability_tree(start_first_chord = "I", max_depth = 2, top_n = 5)
tree_df <- tree_result$edges
start_bar <- tree_result$start_bar
# Create igraph object
graph <- graph_from_data_frame(tree_df, directed = TRUE)
# Assign node depth using BFS
node_depths <- bfs(graph, root = start_bar, dist = TRUE)$dist
V(graph)$depth <- node_depths
# Plot with ggraph
ggraph(graph, layout = 'sugiyama') +
geom_edge_link(aes(label = paste0(round(prob * 100), "%")),
angle_calc = 'along', label_dodge = unit(4, 'mm'), label_size = 3,
arrow = arrow(length = unit(3, 'mm')), end_cap = circle(3, 'mm')) +
geom_node_label(aes(label = name, fill = factor(depth)),
repel = TRUE, size = 2.8, label.padding = unit(0.15, "lines")) +
scale_fill_brewer(palette = "Blues", name = "Depth") +
theme_void() +
ggtitle(paste0("Probability Tree After Bar Starting with '", start_bar, "'"))
build_probability_tree <- function(start_first_chord = "I", max_depth = 2, top_n = 5) {
start_bars <- bar_info %>% filter(first_chord == start_first_chord) %>% pull(bar)
if (length(start_bars) == 0) stop("No starting bars found.")
set.seed(123)  # For reproducibility
start_bar <- sample(start_bars, 1)
tree_edges <- tibble(from = character(), to = character(), prob = numeric())
visited <- c()
expand_node <- function(current_bar, depth) {
if (depth > max_depth) return()
current_last <- bar_info$last_chord[bar_info$bar == current_bar]
if (length(current_last) == 0) return()
transitions <- transition_probs %>%
filter(last_chord_from == current_last) %>%
arrange(desc(prob)) %>%
slice_head(n = top_n)
for (i in seq_len(nrow(transitions))) {
child_bar <- transitions$bar_to[i]
edge <- tibble(from = current_bar, to = child_bar, prob = transitions$prob[i])
tree_edges <<- bind_rows(tree_edges, edge)
if (!(child_bar %in% visited)) {
visited <<- c(visited, child_bar)
expand_node(child_bar, depth + 1)
}
}
}
visited <- c(start_bar)
expand_node(start_bar, 1)
return(list(edges = tree_edges, start_bar = start_bar))
}
# Build the tree
tree_result <- build_probability_tree(start_first_chord = "I", max_depth = 2, top_n = 5)
tree_df <- tree_result$edges
start_bar <- tree_result$start_bar
# Create igraph object
graph <- graph_from_data_frame(tree_df, directed = TRUE)
# Assign node depth using BFS
node_depths <- bfs(graph, root = start_bar, dist = TRUE)$dist
V(graph)$depth <- node_depths
# Plot with ggraph
ggraph(graph, layout = 'sugiyama') +
geom_edge_link(aes(label = paste0(round(prob * 100), "%"), width = prob),
angle_calc = 'along', label_dodge = unit(4, 'mm'), label_size = 3,
arrow = arrow(length = unit(3, 'mm')), end_cap = circle(3, 'mm')) +
scale_edge_width(range = c(0.3, 2), guide = "none") +
geom_node_label(aes(label = name, fill = as.factor(depth)),
repel = TRUE, size = 2.8, label.padding = unit(0.15, "lines")) +
scale_fill_brewer(palette = "Blues", name = "Depth", labels = function(x) paste("Depth", x)) +
theme_void() +
