}
# === 1) Derive July bounds from the data itself ===
first_day <- floor_date(min(july_rows$Date, na.rm = TRUE), unit = "month")
last_day  <- ceiling_date(first_day, unit = "month") - days(1)
all_days  <- tibble(Date = seq(first_day, last_day, by = "day"))
# === 2) Daily P&L joined onto full July grid ===
daily_pnl <- july_rows %>%
group_by(Date) %>%
summarise(Daily_Profit = sum(Realized_Profit_Clean, na.rm = TRUE), .groups = "drop")
first_wd <- wday(first_day, week_start = 1)   # 1=Mon ... 7=Sun
offset   <- first_wd - 1L
daily <- all_days %>%
left_join(daily_pnl, by = "Date") %>%
mutate(
Daily_Profit = replace_na(Daily_Profit, 0),
DayNum       = day(Date),
wd_idx       = wday(Date, week_start = 1),                 # 1..7 Mon..Sun
WeekRow      = ((DayNum - 1L + offset) %/% 7L) + 1L
)
# robust: height of calendar from data
n_weeks <- max(daily$WeekRow, na.rm = TRUE)
# === 3) Best & worst market per day (hover) ===
by_ticker <- july_rows %>%
group_by(Date, Ticker) %>%
summarise(PnL = sum(Realized_Profit_Clean, na.rm = TRUE), .groups = "drop")
best <- by_ticker %>%
group_by(Date) %>% slice_max(PnL, n = 1, with_ties = FALSE) %>%
transmute(Date, Best_Ticker = Ticker, Best_PnL = PnL)
worst <- by_ticker %>%
group_by(Date) %>% slice_min(PnL, n = 1, with_ties = FALSE) %>%
transmute(Date, Worst_Ticker = Ticker, Worst_PnL = PnL)
plot_df <- daily %>%
left_join(best,  by = "Date") %>%
left_join(worst, by = "Date") %>%
mutate(
hover = paste0(
format(Date, "%a, %b %d, %Y"), "<br>",
"Profit: ", dollar(Daily_Profit), "<br>",
"Best: ", ifelse(is.na(Best_Ticker), "—", Best_Ticker),
ifelse(is.na(Best_PnL), "", paste0(" (", dollar(Best_PnL), ")")), "<br>",
"Worst: ", ifelse(is.na(Worst_Ticker), "—", Worst_Ticker),
ifelse(is.na(Worst_PnL), "", paste0(" (", dollar(Worst_PnL), ")"))
)
)
# === 4) Plot (Mon→Sun, week 1 at top) ===
weekday_labels <- c("Mon","Tue","Wed","Thu","Fri","Sat","Sun")
p <- ggplot(plot_df, aes(x = wd_idx, y = WeekRow, fill = Daily_Profit, text = hover)) +
geom_tile(color = "white", linewidth = 0.8, width = 0.95, height = 0.9) +
geom_text(aes(label = DayNum), size = 3.8, fontface = "bold") +
scale_x_continuous(breaks = 1:7, labels = weekday_labels, expand = c(0,0)) +
scale_y_reverse(limits = n_weeks:1, breaks = NULL, expand = c(0.02,0.02)) +
scale_fill_gradient2(low = "#ff4e50", mid = "white", high = "#3cb371",
midpoint = 0, labels = dollar_format(), name = "Profit") +
labs(title = "July Profit Calendar", x = NULL, y = NULL) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
panel.grid = element_blank(),
axis.text.x = element_text(face = "bold")
)
ggplotly(p, tooltip = "text") %>%
layout(legend = list(title = list(text = "Profit (USD)")))
