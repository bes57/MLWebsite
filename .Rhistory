# July trades
Kalshi25July_arb %>%
filter(month(Created_Parsed) == 7) %>%   # July
mutate(Date = as.Date(Created_Parsed)) %>%
count(Date) %>%
ggplot(aes(x = Date, y = n)) +
geom_col(fill = "#0F9D58") +
labs(
title = "Number of Trades per Day – July 2025",
x = "Date",
y = "Number of Trades"
) +
theme_minimal()
Kalshi25July_arb %>%
filter(month(Created_Parsed) == 7) %>%
mutate(Date = as.Date(Created_Parsed)) %>%
count(Date) %>%
arrange(Date) %>%
mutate(Cumulative_Trades = cumsum(n)) %>%
ggplot(aes(x = Date, y = Cumulative_Trades)) +
geom_line(color = "#0F9D58", size = 1.2) +
labs(
title = "Cumulative Number of Trades in July 2025",
x = "Date",
y = "Cumulative Trades"
) +
theme_minimal()
