june_pct <- Kalshi25July_arb %>%
filter(month(Created_Parsed) == 6) %>%
mutate(Type = ifelse(Category == "Baseball", "Baseball", "Non-Baseball")) %>%
count(Type) %>%
mutate(Percent = 100 * n / sum(n))
# Plot June
