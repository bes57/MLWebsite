color = "darkblue"
) +
geom_vline(xintercept = 0, linetype = "dashed", linewidth = 0.7) +
coord_cartesian(xlim = c(-max_abs, max_abs)) +
facet_wrap(~ Month, ncol = 1, scales = "free_y") +  # give each panel full vertical scale
labs(
title = "Profit Distribution for Baseball Markets by Month",
subtitle = "May–August 2025 | Histogram of per-trade profit with month-specific normal overlay",
x = "Profit per Trade (USD)",
y = "Frequency"
) +
theme_minimal(base_size = 16) +   # bigger fonts
theme(
plot.title   = element_text(hjust = 0.5, face = "bold"),
strip.text   = element_text(face = "bold", size = 14),
panel.grid.minor = element_blank()
)
baseball_trades <- Kalshi25August_arb %>%
filter(Category == "Baseball",
!is.na(Realized_Profit_Clean),
!is.na(Created_Parsed)) %>%
mutate(
Month = factor(format(Created_Parsed, "%B"),
levels = c("May","June","July","August"))
) %>%
filter(Month %in% c("May","June","July","August"))
# Fixed x-range and binwidth
max_abs <- 100
binw    <- 5
xbks    <- seq(-max_abs, max_abs, by = binw)
# Month-specific normal curve, scaled to histogram frequency (and clipped to ±100)
normal_overlay <- baseball_trades %>%
group_by(Month) %>%
summarise(
mu = mean(Realized_Profit_Clean, na.rm = TRUE),
sd = sd(Realized_Profit_Clean, na.rm = TRUE),
n  = n(),
.groups = "drop"
) %>%
mutate(x = list(seq(-max_abs, max_abs, length.out = 400))) %>%
tidyr::unnest(x) %>%
mutate(y = n * binw * dnorm(x, mean = mu, sd = sd))
# Plot: stacked facets (one column), x = –100…100
# Larger stacked facets with free y-scale
ggplot(baseball_trades, aes(x = Realized_Profit_Clean)) +
geom_histogram(
breaks = xbks,
color = "white",
fill  = "gray40"
) +
geom_line(
data = normal_overlay,
aes(x = x, y = y),
linewidth = 1,
color = "darkblue"
) +
geom_vline(xintercept = 0, linetype = "dashed", linewidth = 0.7) +
coord_cartesian(xlim = c(-max_abs, max_abs)) +
facet_wrap(~ Month, ncol = 1, scales = "free_y") +  # give each panel full vertical scale
labs(
title = "Profit Distribution for Baseball Markets by Month",
subtitle = "May–August 2025 | Histogram of per-trade profit with month-specific normal overlay",
x = "Profit per Trade (USD)",
y = "Frequency"
) +
theme_minimal(base_size = 16) +   # bigger fonts
theme(
plot.title   = element_text(hjust = 0.5, face = "bold"),
strip.text   = element_text(face = "bold", size = 14),
panel.grid.minor = element_blank()
)
