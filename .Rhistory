generate_bar_sequence <- function(num_bars = 8, key = "C", seed = 1337, num_sequences = 1) {
set.seed(seed)
starting_bars <- bar_info %>%
filter(first_chord == starting_chord) %>%
pull(bar)
out <- character()
for (i in 1:num_sequences) {
sequence <- c(sample(starting_bars, 1))
for (j in 2:num_bars) {
prev_bar <- sequence[length(sequence)]
prev_last <- bar_info %>% filter(bar == prev_bar) %>% pull(last_chord)
options <- transition_probs %>% filter(last_chord_from == prev_last)
if (length(sequence) >= 2 && sequence[length(sequence)] == sequence[length(sequence) - 1]) {
options <- options %>% filter(bar_to != prev_bar)
}
if (nrow(options) == 0) break
next_bar <- sample(options$bar_to, 1, prob = options$prob)
sequence <- c(sequence, next_bar)
}
roman_str <- paste(gsub(",", ", ", sequence), collapse = " | ")
chord_str <- paste(map_chr(sequence, ~ convert_bar_to_chords(.x, key)), collapse = " | ")
out <- c(out, sprintf("=== Sequence %02d ===\nRoman Numerals:\n%s\nIn Key of %s:\n%s\n", i, roman_str, key, chord_str))
}
paste(out, collapse = "\n")
}
# ---- END BARE MINIMUM ----
# ==== UI ====
ui <- fluidPage(
titlePanel("Interactive Jazz Progression Generator"),
sidebarLayout(
sidebarPanel(
numericInput("num_seq", "Number of Sequences", 3, min = 1, max = 20),
numericInput("num_bars", "Bars per Sequence", 8, min = 2, max = 16),
numericInput("seed", "Random Seed", 1337),
textInput("key", "Target Key", "C"),
actionButton("go", "Generate Progressions")
),
mainPanel(
verbatimTextOutput("progression")
)
)
)
# ==== SERVER ====
server <- function(input, output) {
progression_text <- eventReactive(input$go, {
generate_bar_sequence(
num_bars = input$num_bars,
key = input$key,
seed = input$seed,
num_sequences = input$num_seq
)
})
output$progression <- renderText({
progression_text()
})
}
shinyApp(ui = ui, server = server)
