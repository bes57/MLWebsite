# ---- Baseball: per-market totals by month (May–Aug) ----
baseball_markets <- Kalshi25August_arb %>%
filter(Category == "Baseball",
!is.na(Realized_Profit_Clean),
!is.na(Created_Parsed)) %>%
mutate(
Month = factor(format(Created_Parsed, "%B"),
levels = c("May","June","July","August"))
) %>%
filter(Month %in% c("May","June","July","August")) %>%
group_by(Month, Market = Ticker) %>%
summarise(Market_Profit = sum(Realized_Profit_Clean, na.rm = TRUE),
.groups = "drop")
# Fixed x-range and binwidth for histograms
max_abs <- 100
binw    <- 5
xbks    <- seq(-max_abs, max_abs, by = binw)
# Month-specific normal curve, scaled to histogram frequency (handle sd=0 safely)
normal_overlay <- baseball_markets %>%
group_by(Month) %>%
summarise(
mu = mean(Market_Profit, na.rm = TRUE),
sd = sd(Market_Profit,   na.rm = TRUE),
n  = n(),
.groups = "drop"
) %>%
mutate(sd = ifelse(sd < 1e-8, NA_real_, sd),
x  = list(seq(-max_abs, max_abs, length.out = 400))) %>%
tidyr::unnest(x) %>%
mutate(y = ifelse(is.na(sd), 0, n * binw * dnorm(x, mean = mu, sd = sd)))
month_means <- baseball_markets %>%
group_by(Month) %>%
summarise(mu = mean(Market_Profit, na.rm = TRUE), .groups = "drop")
ggplot(baseball_markets, aes(x = Market_Profit)) +
geom_histogram(
breaks = xbks,
color  = "white",
fill   = "purple"
) +
geom_line(
data = normal_overlay,
aes(x = x, y = y),
linewidth = 1,
color = "darkblue",
inherit.aes = FALSE
) +
# vertical line at each month's mean
geom_vline(
data = month_means,
aes(xintercept = mu),
linetype = "dashed",
linewidth = 0.7,
color = "gray30"
) +
coord_cartesian(xlim = c(-max_abs, max_abs)) +
facet_wrap(~ Month, ncol = 1, scales = "free_y") +
labs(
title = "Profit Distribution for Baseball Markets by Month",
x = "Profit per Market (USD)",
y = "Frequency"
) +
theme_light(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
strip.text = element_text(face = "bold", size = 14),
panel.grid.minor = element_blank()
)
