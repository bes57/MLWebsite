import random
import ipywidgets as widgets
from IPython.display import display, Markdown
# ===== Dummy generator for now ===== #
# Replace this with your Markov model when ready
def generate_progression(start="I", bars=8, key="C"):
roman_choices = {
"I": ["I", "IIm7", "V7", "IV", "VI", "IIIm7", "IVm", "Imaj7"],
"Im": ["Im", "IIm7b5", "V7", "iv", "bVI", "bIII", "vii°", "i"]
}
base = roman_choices["Im" if start == "Im" else "I"]
return " | ".join(random.choices(base, k=bars))
# ====== Widgets ====== #
bar_dropdown = widgets.Dropdown(
options=[4, 8, 16],
value=8,
description="Bars:"
)
start_dropdown = widgets.Dropdown(
options=["I", "Im"],
value="I",
description="Start:"
)
seed_input = widgets.IntText(
value=42,
description='Seed:'
)
count_dropdown = widgets.Dropdown(
options=[1, 3, 10],
value=1,
description="Count:"
)
key_dropdown = widgets.Dropdown(
options=["C", "Bb", "Eb", "F", "G", "D", "A"],
value="C",
description="Key:"
)
output_box = widgets.Output()
generate_button = widgets.Button(
description="🎷 Generate Progression",
button_style='primary'
)
def on_generate_clicked(b):
output_box.clear_output()
random.seed(seed_input.value)
with output_box:
for _ in range(count_dropdown.value):
prog = generate_progression(start_dropdown.value, bar_dropdown.value, key_dropdown.value)
display(Markdown(f"**Key: {key_dropdown.value}**\n\n{prog}\n\n---"))
generate_button.on_click(on_generate_clicked)
# ====== Display ====== #
display(bar_dropdown, start_dropdown, seed_input, count_dropdown, key_dropdown, generate_button, output_box)
import random
import ipywidgets as widgets
from IPython.display import display, Markdown
# === Your simplified progression generator ===
def generate_progression(start="I", bars=8, key="C"):
roman_choices = {
"I": ["I", "IIm7", "V7", "IV", "VI", "IIIm7", "IVm", "Imaj7"],
"Im": ["Im", "IIm7b5", "V7", "iv", "bVI", "bIII", "vii°", "i"]
}
base = roman_choices["Im" if start == "Im" else "I"]
return " | ".join(random.choices(base, k=bars))
# === Widgets ===
bar_dropdown = widgets.Dropdown(options=[4, 8, 16], value=8, description="Bars:")
start_dropdown = widgets.Dropdown(options=["I", "Im"], value="I", description="Start:")
seed_input = widgets.IntText(value=42, description='Seed:')
count_dropdown = widgets.Dropdown(options=[1, 3, 10], value=1, description="Count:")
key_dropdown = widgets.Dropdown(options=["C", "Bb", "Eb", "F", "G", "D", "A"], value="C", description="Key:")
output_box = widgets.Output()
generate_button = widgets.Button(description="🎷 Generate Progression", button_style='primary')
# === Generator handler ===
def on_generate_clicked(b):
output_box.clear_output()
random.seed(seed_input.value)
with output_box:
for _ in range(count_dropdown.value):
prog = generate_progression(start_dropdown.value, bar_dropdown.value, key_dropdown.value)
display(Markdown(f"**Key: {key_dropdown.value}**\n\n{prog}\n\n---"))
generate_button.on_click(on_generate_clicked)
# === Display UI ===
display(bar_dropdown, start_dropdown, seed_input, count_dropdown, key_dropdown, generate_button, output_box)
